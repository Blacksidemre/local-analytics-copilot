// OpenClaw + local Ollama example.
// IMPORTANT: native Ollama base URL only. Do not append /v1 when native tool calling matters.
{
  models: {
    providers: {
      ollama: {
        baseUrl: "http://127.0.0.1:11434",
        apiKey: "ollama-local",
        api: "ollama",
        timeoutSeconds: 300,
        contextWindow: 32768,
        maxTokens: 4096,
        models: [
          {
            id: "qwen3.5:9b",
            name: "qwen3.5:9b",
            reasoning: true,
            input: ["text", "image"],
            params: { num_ctx: 32768, thinking: true, keep_alive: "15m" }
          },
          {
            id: "gpt-oss:20b",
            name: "gpt-oss:20b",
            reasoning: true,
            input: ["text"],
            params: { num_ctx: 32768, keep_alive: "15m" }
          }
        ]
      }
    }
  },
  agents: {
    defaults: {
      model: {
        primary: "ollama/qwen3.5:9b",
        fallbacks: ["ollama/gpt-oss:20b"]
      }
    }
  }
}
