# Core — no paid cloud API is required
LAC_WORKSPACE=./workspace
LAC_OLLAMA_HOST=http://127.0.0.1:11434
LAC_FAST_MODEL=qwen3.5:9b
LAC_MODEL=qwen3.5:9b
LAC_DEEP_MODEL=gpt-oss:20b
LAC_MODEL_MODE=main
LAC_CONTEXT_WINDOW=32768
LAC_MAX_OUTPUT_TOKENS=4096
LAC_MAX_TOOL_ROUNDS=10
LAC_MAX_TOOL_RESULT_CHARS=30000
LAC_PERSONALITY=mentor

# Privacy / security
LAC_ALLOW_WEB=false
LAC_ALLOW_REMOTE_OLLAMA=false
LAC_ALLOW_CLOUD_MODELS=false
LAC_ALLOW_NETWORK_BIND=false
# Optional API token. Strongly recommended if binding beyond localhost/private single-user use.
LAC_API_TOKEN=
LAC_SQL_READ_ONLY=true
LAC_REQUIRE_APPROVAL_FOR_WRITES=true
LAC_REQUIRE_APPROVAL_FOR_EXTERNAL=true
LAC_MAX_FILE_MB=500
LAC_MAX_QUERY_ROWS=5000

# Optional database connection URLs. Keep credentials in environment variables, never in prompts/YAML.
# LAC_DB_MAIN_URL=postgresql+psycopg://user:pass@localhost/db
# LAC_DB_SQLSERVER_URL=mssql+pyodbc://user:pass@server/db?driver=ODBC+Driver+18+for+SQL+Server
